---
import { getCollection } from 'astro:content';
import { getLocaleFromUrl } from '../i18n';
const locale = getLocaleFromUrl(Astro.url);
const all = await getCollection('experience', e => e.data.lang === locale);
const items = all.sort((a, b) => a.data.order - b.data.order);
---
<section id="experience" class="mx-auto max-w-5xl px-6 py-16">
  <h2 class="text-3xl font-semibold mb-10">Experience</h2>
  <ol class="relative border-l border-slate-200 dark:border-slate-800 ml-3">
    {items.map(item => (
      <li class="timeline-item ml-6 mb-10">
        <span class="absolute -left-2.5 mt-1.5 h-5 w-5 rounded-full bg-brand"></span>
        <div class="flex flex-wrap items-baseline gap-x-3">
          <h3 class="text-xl font-semibold">{item.data.title}</h3>
          <span class="text-slate-500">{item.data.company}</span>
          <span class="text-sm text-slate-400">{item.data.period}</span>
        </div>
        <ul class="mt-3 space-y-2 text-slate-700 dark:text-slate-300 text-sm leading-relaxed list-disc pl-5">
          {item.data.bullets.map(b => <li>{b}</li>)}
        </ul>
      </li>
    ))}
  </ol>
</section>
