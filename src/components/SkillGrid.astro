---
import { getLocaleFromUrl } from '../i18n';
const locale = getLocaleFromUrl(Astro.url);
const labels = locale === 'zh-TW'
  ? { be: '後端', ai: 'AI / LLM', fe: '前端', ops: 'DevOps / Cloud', tools: '工具與實踐' }
  : { be: 'Backend', ai: 'AI / LLM', fe: 'Frontend', ops: 'DevOps / Cloud', tools: 'Tools & Practices' };
const groups = [
  { key: 'be', items: ['Node.js (NestJS)', 'TypeScript', 'RESTful API', 'Microservices', 'PHP (Laravel)', 'ASP.NET (C#)', 'PostgreSQL', 'MySQL', 'Redis'] },
  { key: 'ai', items: ['LLM Integration', 'Prompt Engineering', 'RAG / Hybrid Retrieval', 'Agent Orchestration', 'Claude Code', 'AI Code Review', 'SDD'] },
  { key: 'fe', items: ['JavaScript', 'TypeScript', 'HTML5', 'CSS3', 'Tailwind CSS', 'Astro'] },
  { key: 'ops', items: ['Docker', 'Kubernetes (K8s/K9s operations)', 'Terraform (IaC)', 'GitLab CI/CD', 'GitHub Actions', 'GCP', 'AWS', 'Azure'] },
  { key: 'tools', items: ['Git', 'Code Review', 'Agile/Scrum', 'System Design', 'OpenAPI v3.0', 'Cross-functional Collaboration'] }
];
---
<section id="skills" class="mx-auto max-w-5xl px-6 py-16">
  <h2 class="text-3xl font-semibold mb-8">Technical Skills</h2>
  <div class="grid md:grid-cols-2 gap-8">
    {groups.map(g => (
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-500 mb-3">{labels[g.key as keyof typeof labels]}</h3>
        <div class="flex flex-wrap gap-2">
          {g.items.map(s => (
            <span class="rounded-md border border-slate-300 dark:border-slate-700 px-2.5 py-1 text-xs">{s}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
