---
import type { CollectionEntry } from 'astro:content';
import { getLocaleFromUrl, t } from '../i18n';
export interface Props { entry: CollectionEntry<'sideProjects'>; }
const { entry } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
---
<a href={entry.data.repo} target="_blank" rel="noopener"
   class="case-card block rounded-lg border border-slate-200 dark:border-slate-800 p-6 hover:border-brand transition-colors">
  <h3 class="text-xl font-semibold">{entry.data.name}</h3>
  <p class="mt-2 text-sm text-slate-500">{entry.data.tagline}</p>
  {entry.data.highlight && (
    <p class="mt-3 text-xs text-slate-600 dark:text-slate-400 italic">{entry.data.highlight}</p>
  )}
  <div class="mt-4 flex flex-wrap gap-2">
    {entry.data.techStack.slice(0, 4).map((s: string) => (
      <span class="rounded bg-slate-100 dark:bg-slate-800 px-2 py-0.5 text-xs">{s}</span>
    ))}
  </div>
  <div class="mt-4 text-brand text-sm">{t(locale, 'cta.viewRepo')} ↗</div>
</a>
