---
<button
  type="button"
  class="theme-toggle no-print rounded-md p-2 hover:bg-slate-200 dark:hover:bg-slate-800"
  aria-label="Toggle dark mode"
  data-theme-toggle
>
  <svg class="h-5 w-5 hidden dark:block" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1Z"/></svg>
  <svg class="h-5 w-5 block dark:hidden" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4V2m0 20v-2m8-8h2M2 12h2m13.66-5.66 1.41-1.41M4.93 19.07l1.41-1.41m0-11.32L4.93 4.93m14.14 14.14-1.41-1.41M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Z" stroke="currentColor" stroke-width="2" fill="none"/></svg>
</button>

<script>
  import { toggleTheme } from '../lib/theme';
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', toggleTheme);
</script>
