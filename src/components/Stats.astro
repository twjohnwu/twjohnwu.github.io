---
import StatsCounter from './StatsCounter.vue';
import { getLocaleFromUrl } from '../i18n';
const locale = getLocaleFromUrl(Astro.url);
const items = locale === 'zh-TW'
  ? [
      { value: 113000, label: '2020 跨年夜偵測人次' },
      { value: 314, suffix: '+', label: 'WiSide 部署的掃描器' },
      { value: 12, label: '團隊人數高點（重組期間 5–12 人）' },
      { value: 10, suffix: '+', label: '年上線系統開發經驗' }
    ]
  : [
      { value: 113000, label: 'People detected, NYE 2020' },
      { value: 314, suffix: '+', label: 'WiSide scanners deployed' },
      { value: 12, label: 'Peak team size (5–12 through reorgs)' },
      { value: 10, suffix: '+', label: 'Years shipping production systems' }
    ];
---
<section id="stats" class="mx-auto max-w-5xl px-6 py-16">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
    {items.map(it => (
      <div>
        <div class="text-3xl md:text-4xl font-bold text-brand">
          <StatsCounter client:visible value={it.value} suffix={it.suffix} />
        </div>
        <div class="mt-2 text-sm text-slate-500">{it.label}</div>
      </div>
    ))}
  </div>
</section>
