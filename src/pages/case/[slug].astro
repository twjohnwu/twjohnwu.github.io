---
import { getCollection } from 'astro:content';
import CaseLayout from '../../layouts/CaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('cases', e => e.data.lang === 'zh-TW');
  return entries.map(entry => ({ params: { slug: entry.data.urlSlug }, props: { entry } }));
}
const { entry } = Astro.props;
---
<CaseLayout entry={entry} />
